<Window x:Class="pr23.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr23"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="800"  Background="LightGray">

    <Window.Resources>

        <ControlTemplate x:Key="ErrorTemplate">
            <StackPanel>
                <Border BorderBrush="Red" BorderThickness="2">
                    <AdornedElementPlaceholder/>
                </Border>
                <TextBlock Foreground="Red" FontSize="12"
                           Text="{Binding [0].ErrorContent}" />
            </StackPanel>
        </ControlTemplate>

        <Style TargetType="Button" x:Key="ButtonRegistration">
            <Setter Property="IsEnabled" Value="True"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=txtName}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=txtGroup}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=txtAge}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked, ElementName=chkAgree}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <StackPanel >

        <TextBlock Text="Анкета студента"
                   FontSize="26" FontWeight="Bold" Margin="10,10,10,20"/>

        <TextBlock Text="ФИО:" FontSize="16" Margin="10,8,10,0"/>
        <TextBox x:Name="txtName" Margin="10" FontSize="14"
                 Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                 Text="{Binding FullName,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"/>

        <TextBlock Text="Группа:" FontSize="16" Margin="10,8,10,0"/>
        <TextBox x:Name="txtGroup" Margin="10" FontSize="14"
                 Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                 Text="{Binding Group, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

        <TextBlock Text="Возраст:" FontSize="16" Margin="10,8,10,0"/>
        <TextBox x:Name="txtAge" Margin="10" FontSize="14"
                 Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                 Text="{Binding Age, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

        <TextBlock Text="Курс:" FontSize="16" Margin="10,8,10,0"/>
        <ComboBox x:Name="cmbCourse" Margin="10" Width="80" HorizontalAlignment="Left"/>

        <CheckBox x:Name="chkAgree" Margin="10,15,10,0" FontSize="15">Согласен на обработку данных</CheckBox>

        <Button Content="Сохранить" Click="Save_Click"
                Style="{StaticResource ButtonRegistration}"/>
    </StackPanel>
</Window>

